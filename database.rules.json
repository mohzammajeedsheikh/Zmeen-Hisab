{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$key": {
          ".validate": "($key === 'khata' || $key === 'hist' || $key === 's') && newData.isString() && newData.val().length < 3000000"
        }
      }
    }
  }
}
